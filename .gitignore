# ---- Dependencies ----
/vendor/
/node_modules/

# ---- Local environment / secrets ----
# These hold DB and SMTP credentials. Commit *.example versions instead.
/config/database.php
/config/mail.php
/config/attendance.php
.env
.env.*

# ---- Attendance module runtime data (frames are biometric evidence) ----
/attendance/.env
/attendance/data/

# ---- Installer marker ----
/.installed

# ---- Generated / runtime data ----
# Logs
/logs/*
!/logs/.gitkeep

# User uploads (medical certificates, supporting documents — sensitive)
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/medical_documents/.gitkeep

# Database backups and ad-hoc dumps
/database/backups/*
!/database/backups/.gitkeep
/proddump.sql
# Schema snapshots pulled off production. schema.sql and migrations/ are the
# tracked, reviewed definitions; these are local reference copies and carry the
# exact shape of the live database, so they stay out of the repo.
/database/prod-schema-*.sql
*.sql.gz
*.dump

# Test coverage output
/coverage/
.phpunit.result.cache

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ---- Build / cache ----
*.log
*.cache
.cache/
