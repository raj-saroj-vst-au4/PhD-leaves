# Copy to .env (chmod 600) and fill in. Never commit .env.

# --- database: the SAME phd_timeoff schema the PHP portal uses ---
# Connect over the MySQL unix socket (works with rootless Docker and with
# databases bound to 127.0.0.1). Leave empty to use DB_HOST/DB_PORT instead.
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=phd_timeoff
# Use the dedicated user created by ops/grants.sql (append-only enforcement),
# NOT the PHP app's user.
DB_USER=attendance_app
DB_PASSWORD=

# --- auth bridge: must equal ATT_SHARED_SECRET in config/attendance.php ---
# Generate with: openssl rand -hex 32
ATT_SHARED_SECRET=
SHARED_SECRET=${ATT_SHARED_SECRET}

# --- host jobs (systemd timers) authenticate with this ---
# Generate with: openssl rand -hex 32
JOB_TOKEN=

# --- email for the monthly report (same relay the PHP portal uses) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=phd-attendance@som.iitb.ac.in

# --- storage inside the container (mapped in docker-compose.yml) ---
FRAMES_DIR=/data/frames
REPORTS_DIR=/data/reports

MODEL_ROOT=/models
LOG_LEVEL=INFO

# --- face engine concurrency and request limits (defaults shown) ---
# Concurrent verifications per uvicorn worker, how long a request may queue
# for one before the student is told to retry, and the largest request body.
# FACE_WORKERS=2
# FACE_QUEUE_TIMEOUT=30
# MAX_BODY_BYTES=12582912

# uid:gid the container runs as, so it can write ./data.
# Rootful Docker: the host user owning ./data (e.g. 1000:1000).
# Rootless Docker: 0:0 (container-root maps to the unprivileged host user).
ATT_CONTAINER_USER=1000:1000
